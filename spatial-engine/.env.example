# Spatial Engine Environment Configuration
# Copy to .env and fill in values

# Backend
DATA_ROOT=./data/scenes
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# COLMAP binary path (if not on system PATH)
COLMAP_BIN=colmap

# 3D Gaussian Splatting trainer script path
# GS_TRAIN_SCRIPT=/path/to/train.py

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# GPU Settings
CUDA_VISIBLE_DEVICES=0
